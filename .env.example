# Copy to .env for local development:  cp .env.example .env
# Every variable the server reads is listed here. Values below are safe placeholders.

# --- Database (required) ---
DATABASE_URL=postgres://localhost:5432/forge5
# "true" to connect with TLS (managed Postgres such as Render/Heroku). Certificates are not verified.
DATABASE_SSL=false

# --- Server ---
PORT=3000
# "production" enables secure cookies, HSTS, the redacted mailer and stricter config checks.
NODE_ENV=development
# Public origin of the site. Used in email links and the CSRF Origin check.
# Dev default: http://localhost:5173 (Vite). Required in production, e.g. https://forge5.example.com
APP_URL=http://localhost:5173
# Number of reverse-proxy hops in front of the app (Render/Heroku/nginx: 1). 0 = none.
TRUST_PROXY=0

# --- Admin ---
# At least 16 characters. Unset/short = admin sign-in disabled (production refuses to start if set but short).
# Generate one with: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_PASSWORD=change-me-to-a-long-random-string

# --- Email ---
# nodemailer SMTP URL, e.g. smtps://user:password@smtp.example.com:465
# Unset: dev prints emails (incl. sign-in links) to the console; production sends nothing.
SMTP_URL=
MAIL_FROM="Forge5 <no-reply@forge5.example.com>"

# --- Policy ---
# Comma-separated email domain suffixes allowed to register. Empty = any domain.
ALLOWED_EMAIL_DOMAINS=.edu
# Require a confirmed email before voting. Default: true when SMTP_URL is set, else false.
REQUIRE_VERIFIED_EMAIL_TO_VOTE=
