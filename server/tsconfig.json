{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "../dist",
    "rootDir": "..",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src", "../shared"]
}
